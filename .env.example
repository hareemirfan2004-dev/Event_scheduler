# Neon Postgres, used for local dev, tests and production. Use the POOLED
# connection string from the Neon dashboard (hostname contains -pooler).
# Point local dev and tests at a separate Neon branch, never at production;
# see README "Local development".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
